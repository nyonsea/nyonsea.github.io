## 【Phase 4】HARファイルのエクスポート

### 4-1. コマンドラインでIdP通信のみHARに保存（最も確実な方法）

mitmproxyには `--save-stream-file` と `mitmdump` を組み合わせた方法が確実です。

#### 専用スクリプト `export_idp_har.py` を作成：

```python
# export_idp_har.py
# IdP関連通信のみをHARとして出力するスクリプト

import json
import time
from datetime import datetime, timezone

# ★ 実際のJリーグIdPドメインに変更
TARGET_DOMAINS = [
    "auth.jleague.jp",
    "id.jleague.jp",
]

captured_entries = []

HAR_TEMPLATE = {
    "log": {
        "version": "1.2",
        "creator": {
            "name": "mitmproxy",
            "version": "1.0"
        },
        "entries": []
    }
}

def should_capture(flow) -> bool:
    host = flow.request.pretty_host
    return any(domain in host for domain in TARGET_DOMAINS)

def response(flow):
    if not should_capture(flow):
        return

    req = flow.request
    res = flow.response

    # リクエストヘッダー
    req_headers = [{"name": k, "value": v} for k, v in req.headers.items()]
    # レスポンスヘッダー
    res_headers = [{"name": k, "value": v} for k, v in res.headers.items()]

    entry = {
        "startedDateTime": datetime.fromtimestamp(
            req.timestamp_start, tz=timezone.utc
        ).isoformat(),
        "time": (flow.response.timestamp_end - req.timestamp_start) * 1000,
        "request": {
            "method": req.method,
            "url": req.pretty_url,
            "httpVersion": "HTTP/1.1",
            "headers": req_headers,
            "queryString": [
                {"name": k, "value": v}
                for k, v in req.query.items()
            ],
            "postData": {
                "mimeType": req.headers.get("content-type", ""),
                "text": req.get_text(strict=False) or ""
            } if req.content else None,
            "cookies": [],
            "headersSize": -1,
            "bodySize": len(req.content) if req.content else 0,
        },
        "response": {
            "status": res.status_code,
            "statusText": res.reason or "",
            "httpVersion": "HTTP/1.1",
            "headers": res_headers,
            "content": {
                "size": len(res.content) if res.content else 0,
                "mimeType": res.headers.get("content-type", ""),
                "text": res.get_text(strict=False) or ""
            },
            "cookies": [],
            "redirectURL": res.headers.get("location", ""),
            "headersSize": -1,
            "bodySize": len(res.content) if res.content else 0,
        },
        "timings": {
            "send": 0,
            "wait": (res.timestamp_start - req.timestamp_end) * 1000
                    if req.timestamp_end else 0,
            "receive": (res.timestamp_end - res.timestamp_start) * 1000,
        },
        "cache": {}
    }

    captured_entries.append(entry)
    print(f"[CAPTURED] {req.method} {req.pretty_url}")

def done():
    """mitmproxy終了時にHARファイルを出力"""
    HAR_TEMPLATE["log"]["entries"] = captured_entries
    output_path = f"jleague_idp_{datetime.now().strftime('%Y%m%d_%H%M%S')}.har"
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(HAR_TEMPLATE, f, ensure_ascii=False, indent=2)
    print(f"\n✅ HARファイルを保存しました: {output_path}")
    print(f"   キャプチャ件数: {len(captured_entries)} リクエスト")
```

#### このスクリプトで起動：

```bash
mitmweb \
  --listen-host 0.0.0.0 \
  --listen-port 8080 \
  --web-port 8081 \
  -s export_idp_har.py
```

#### 終了方法（HARファイルを出力するため）：
```
Ctrl + C で mitmweb を終了
→ カレントディレクトリに jleague_idp_YYYYMMDD_HHMMSS.har が生成される
```

