# =============================================
# ADユーザー一括削除スクリプト（CSV自動処理）
# 対象フォルダ: \\ABC\share
# PowerShell 5.1対応・三項演算子未使用版
# =============================================

#Requires -Modules ActiveDirectory
#Requires -Version 5.1

[CmdletBinding()]
param(
    [string]$FolderPath = '\\ABC\share'
)

# 設定
$ProcessedFolder = Join-Path $FolderPath "Processed"
$LogPath = Join-Path $FolderPath "DeleteLog_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"

# ログ関数
function Write-Log {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory=$true)]
        [string]$Message,
        
        [ValidateSet('Info','Warning','Error')]
        [string]$Level = 'Info'
    )
    
    $Timestamp = Get-Date -Format "yyyy/MM/dd HH:mm:ss"
    $LogEntry = "$Timestamp [$Level] $Message"
    
    switch ($Level) {
        'Warning' { Write-Warning $Message }
        'Error'   { Write-Error $Message }
        default   { Write-Host $LogEntry -ForegroundColor Cyan }
    }
    
    $LogEntry | Out-File -FilePath $LogPath -Append -Encoding UTF8
}

try {
    Write-Log "=== ADユーザー削除処理開始 ==="

    # Processedフォルダ作成
    if (-not (Test-Path $ProcessedFolder)) {
        New-Item -Path $ProcessedFolder -ItemType Directory -Force | Out-Null
    }

    # CSVファイル取得
    $CsvFiles = Get-ChildItem -Path $FolderPath -Filter "*.csv" -File -ErrorAction Stop

    if ($CsvFiles.Count -eq 0) {
        Write-Log "処理対象のCSVファイルが見つかりませんでした。" -Level Warning
        exit 0
    }

    foreach ($Csv in $CsvFiles) {
        Write-Log "ファイル処理開始: $($Csv.Name)"
        
        $Users = Import-Csv -Path $Csv.FullName -Encoding UTF8 -ErrorAction Stop
        
        foreach ($User in $Users) {
            
            # === 列名対応（三項演算子未使用）===
            $SamAccountName = $null
            
            if ($User.UserName) {
                $SamAccountName = $User.UserName
            }
            elseif ($User.SamAccountName) {
                $SamAccountName = $User.SamAccountName
            }
            elseif ($User.'ユーザー名') {
                $SamAccountName = $User.'ユーザー名'
            }
            elseif ($User[0]) {
                $SamAccountName = $User[0]
            }
            
            if ([string]::IsNullOrWhiteSpace($SamAccountName)) {
                continue
            }

            # ADユーザー存在確認
            $AdUser = Get-ADUser -Filter "SamAccountName -eq '$SamAccountName'" -ErrorAction SilentlyContinue
            
            if ($AdUser) {
                try {
                    Remove-ADUser -Identity $AdUser.DistinguishedName -Confirm:$false -ErrorAction Stop
                    Write-Log "削除成功: $SamAccountName"
                }
                catch {
                    Write-Log "削除失敗: $SamAccountName - $($_.Exception.Message)" -Level Error
                }
            }
            else {
                Write-Log "存在しないためスキップ: $SamAccountName" -Level Warning
            }
        }

        # 処理済みファイルを移動
        Move-Item -Path $Csv.FullName -Destination $ProcessedFolder -Force -ErrorAction Stop
        Write-Log "ファイル処理完了: $($Csv.Name) → Processedフォルダへ移動"
    }

    Write-Log "=== すべての処理が完了しました ==="
}
catch {
    Write-Log "スクリプト全体でエラーが発生: $($_.Exception.Message)" -Level Error
    exit 1
}

